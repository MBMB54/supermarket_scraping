{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "EcrLogin", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*"},
    {
      "Sid": "EcrPush", "Effect": "Allow",
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart",
                 "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": "arn:aws:ecr:eu-west-1:557690579730epository/docker-images"
    },
    {
      "Sid": "BatchJobDefinitions", "Effect": "Allow",
      "Action": ["batch:DescribeJobDefinitions", "batch:RegisterJobDefinition"],
      "Resource": "*"
    },
    {
      "Sid": "PassBatchRoles", "Effect": "Allow", "Action": "iam:PassRole",
      "Resource": ["arn:aws:iam::557690579730ole/supermarket-batch-job-role",
                   "arn:aws:iam::557690579730ole/supermarket-batch-execution-role"],
      "Condition": {"StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}}
    },
    {
      "Sid": "DeployScheduler", "Effect": "Allow", "Action": "lambda:UpdateFunctionCode",
      "Resource": "arn:aws:lambda:eu-west-1:557690579730nction:supermarket_batch_scheduler"
    }
  ]
}
