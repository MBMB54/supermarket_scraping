{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteRaw", "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::ie-supermarket-data/raw/*"
    },
    {
      "Sid": "ListRaw", "Effect": "Allow", "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::ie-supermarket-data",
      "Condition": {"StringLike": {"s3:prefix": ["raw/*"]}}
    }
  ]
}
